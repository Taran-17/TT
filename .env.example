# Required to actually talk to the model.
GROQ_API_KEY=

# Optional override of the primary model (falls back to llama-3.3-70b-versatile,
# then llama-3.1-8b-instant, if unset or if a call fails).
GROQ_MODEL=

# Postgres connection string. If unset, falls back to a local SQLite file
# (techtailor_agent.db) - fine for a quick local demo, but a real deployment
# should set this: SQLite on most PaaS free tiers lives on an ephemeral
# filesystem and gets wiped on every restart/redeploy.
DATABASE_URL=postgresql://techtailor:techtailor@localhost:5432/techtailor

# Redis connection string. If unset, session state/cache/pub-sub all fall
# back to in-process equivalents, which is fine for one worker but breaks
# (silently) the moment you scale to more than one process/dyno.
REDIS_URL=redis://localhost:6379/0
